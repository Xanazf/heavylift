{
  "name": "heavylift",
  "version": "0.1.8",
  "description": "A lightweight CSS design system merging MD3, LiftKit, and Tailwind-like utility.",
  "main": "./dist/core.js",
  "module": "./dist/core.mjs",
  "types": "./dist/core.d.ts",
  "style": "./dist/global.css",
  "bin": {
    "heavylift-gen": "./dist/generateScheme.js"
  },
  "scripts": {
    "generate-scheme": "bun scripts/generateScheme.ts",
    "scaffold": "bun scripts/scaffold.ts",
    "test": "vitest run",
    "release": "bun run check && bun run test && bun run build && bun publish --access public",
    "build:css": "lightningcss styles/global.css -o dist/global.css --minify --bundle --targets '>= 0.25%' && find styles/lib-hl -name '*.ttf' -exec cp {} dist/ ';' && find styles/lib-hl -name '*.woff2' -exec cp {} dist/ ';'",
    "build:ts": "tsup",
    "build": "bun run build:css && bun run build:ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write . && tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./styles": "./dist/global.css",
    "./generator": {
      "types": "./dist/colorSchemeGenerator.d.ts",
      "import": "./dist/colorSchemeGenerator.mjs",
      "require": "./dist/colorSchemeGenerator.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.7",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "figlet": "^1.11.0",
    "lightningcss-cli": "^1.32.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
